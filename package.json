{
  "name": "either-lite",
  "version": "0.1.0",
  "description": "Minimal Either with typed async chains — left/right factories, type-guard narrowing, fail-loud handlers, zero dependencies",
  "main": "dist/either.js",
  "types": "dist/either.d.ts",
  "exports": {
    ".": {
      "types": "./dist/either.d.ts",
      "default": "./dist/either.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "LakeVostok",
  "repository": "LakeVostok/either-lite",
  "bugs": "https://github.com/LakeVostok/either-lite/issues",
  "homepage": "https://github.com/LakeVostok/either-lite#readme",
  "keywords": [
    "either",
    "result",
    "monad",
    "error-handling",
    "async",
    "functional"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm t && npm run tsc",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
